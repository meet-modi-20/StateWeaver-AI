# StateWeaver AI Environment Configuration

# Application Server
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Optional LLM API Keys (StateWeaver AI operates fully deterministically without keys,
# and augments task diversity when AI keys are provided)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Innodata Benchmark Target
BENCHMARK_STANDARD=Innodata-Frontier-AI-2026.1
ISOLATION_BACKEND=subprocess
